# 复制为 .env 并填入真实值：  cp .env.example .env
# .env 已被 gitignore，不会入库；本模板可入库供他人参考。

# ============ 网关凭证（JD_LLM_*）============

# 【必填】网关 API Key
JD_LLM_API_KEY=your-api-key-here

# 【必填】网关地址（OpenAI 兼容根路径）
JD_LLM_BASE_URL=http://llm-gw.jd.local/v1

# 主模型 id
XIAOSHU_MODEL=Gemini-3.1-Pro-Preview-joybuilder

# fallback 链（逗号分隔）：某模型配额耗尽（code:2001）时按序切换
JD_LLM_FALLBACK_MODELS=Gemini-3.1-Pro-Preview-joybuilder,Gemini-3-Flash-Preview-joybuilder,Claude-Sonnet-4.6-joybuilder

# 【可选】按任务路由模型（JSON）。任务：classify|extract|sop|review|paraphrase|aggregate
# 留空则用内置默认（分类/扩写走 Flash，抽取/SOP/审核走 Pro）
JD_LLM_TASK_MODELS=

# 【可选】视觉（读图）专用链，逗号分隔。！！只能放多模态模型（Claude/Gemini），
# 绝不能放纯文本模型（如 DeepSeek），否则会静默忽略图片、瞎编转写。
# 留空则从通用链里自动筛出多模态模型。
JD_LLM_VISION_MODELS=

# 【可选】简单任务（问法扩写）的快/省链，逗号分隔
JD_LLM_SIMPLE_MODELS=

# 单请求超时秒数 / 瞬时错误重试次数
JD_LLM_TIMEOUT=90
JD_LLM_MAX_RETRIES=3

# ============ 流水线开关（RAGKB_*）============

# 文档并发数，同时是全局并发上限（网关有限流，调太高只增加重试，建议 ≤ 4）
RAGKB_MAX_WORKERS=4

# 语义审核无法定论时：fail_closed=丢弃(安全,绝不发布未审内容) / keep=保留并标记待人工复核
RAGKB_SEMANTIC_GATE_POLICY=fail_closed

# 是否额外生成问法扩写（实验性；主产物默认忠于原文，置 false）
RAGKB_ENABLE_PARAPHRASES=false
